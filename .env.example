# Copy to .env and fill in what you have. You only need ONE key to start (Groq is the easiest).
# Groq (free, no card): https://console.groq.com/keys   <- also gives you free Whisper speech-to-text
GROQ_API_KEY=
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: only works if your credit balance is ABOVE $0 (negative balances get 402, even for :free models)
OPENROUTER_API_KEY=
# Optional local fallback with Ollama (unlimited, offline): `ollama pull llama3.2`, then:
# OLLAMA_MODEL=llama3.2
# Pick a specific .vrm in models/ (default: first one found)
# VRM_FILE=my_girl.vrm
# Print what the mic hears
# DEBUG_STT=1
